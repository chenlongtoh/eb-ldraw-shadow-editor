{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@eb/ldraw-models": ["../eb-ldraw-toolkit/packages/ldraw-models/src/index.ts"],
      "@eb/ldraw-parser": ["../eb-ldraw-toolkit/packages/ldraw-parser/src/index.ts"],
      "@eb/ldraw-three-core": ["../eb-ldraw-toolkit/packages/ldraw-three-core/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
