# Path to the LDCad shadow connectivity library (read + write).
# Relative paths are resolved from the part-connectivity-editor package root.
LDCAD_SHADOW_LIBRARY=../LDCadShadowLibrary

# Optional: root that contains the LDraw parts tree (default: ../instruction-builder/public)
# LDRAW_PARTS_ROOT=../instruction-builder/public
# Optional subdirectory under that root (default: ldraw-parts)
# LDRAW_PARTS_SUBDIR=ldraw-parts
